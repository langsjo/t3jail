# The VM's only route out. Rendered by t3jail; see internal/jailnet/firewall.go.
table inet t3jail {
	# Never reachable from the guest unless an explicit address entry allows it.
	set blocked4 {
		type ipv4_addr; flags interval; auto-merge
		elements = { {{join .Blocked4 ", "}} }
	}
	set blocked6 {
		type ipv6_addr; flags interval; auto-merge
		elements = { {{join .Blocked6 ", "}} }
	}
	# The host's own addresses and on-link networks, kept up to date by t3jail.
	set hostnets4 { type ipv4_addr; flags interval; auto-merge; }
	set hostnets6 { type ipv6_addr; flags interval; auto-merge; }
	# Address blocks from network.list; they win over every allow.
	set deny4 { type ipv4_addr; flags interval; auto-merge; }
	set deny6 { type ipv6_addr; flags interval; auto-merge; }
	# Explicit address entries from network.list.
	set cidr_allow4 { type ipv4_addr . inet_proto . inet_service; flags interval; }
	set cidr_allow6 { type ipv6_addr . inet_proto . inet_service; flags interval; }
	# Addresses the DNS filter resolved for allowed names.
	set dns_allow4 { type ipv4_addr . inet_proto . inet_service; flags interval; }
	set dns_allow6 { type ipv6_addr . inet_proto . inet_service; flags interval; }

	chain input {
		type filter hook input priority filter; policy accept;
		iifname "{{.Tap}}" ip daddr {{.Gateway4}} meta l4proto { tcp, udp } th dport 53 accept
		iifname "{{.Tap}}" ip6 daddr {{.Gateway6}} meta l4proto { tcp, udp } th dport 53 accept
		iifname "{{.Tap}}" icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert } accept
		iifname "{{.Tap}}" goto refuse
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		iifname "{{.Tap}}" ip daddr @deny4 goto refuse
		iifname "{{.Tap}}" ip6 daddr @deny6 goto refuse
		iifname "{{.Tap}}" ip daddr . meta l4proto . th dport @cidr_allow4 accept
		iifname "{{.Tap}}" ip6 daddr . meta l4proto . th dport @cidr_allow6 accept
		iifname "{{.Tap}}" ip daddr @blocked4 goto refuse
		iifname "{{.Tap}}" ip6 daddr @blocked6 goto refuse
		iifname "{{.Tap}}" ip daddr @hostnets4 goto refuse
		iifname "{{.Tap}}" ip6 daddr @hostnets6 goto refuse
		iifname "{{.Tap}}" jump unfiltered
		iifname "{{.Tap}}" ip daddr . meta l4proto . th dport @dns_allow4 accept
		iifname "{{.Tap}}" ip6 daddr . meta l4proto . th dport @dns_allow6 accept
		iifname "{{.Tap}}" goto refuse
	}

	# Empty unless the network is in open mode, which adds an accept rule,
	# letting through anything not blocked above.
	chain unfiltered {
	}

	# Fail fast instead of letting clients hang until they time out.
	chain refuse {
		meta l4proto tcp reject with tcp reset
		reject with icmpx admin-prohibited
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname != "{{.Tap}}" masquerade
	}
}
